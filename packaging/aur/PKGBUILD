# Maintainer: Wandering Monster <most+claude@alba.win>
#
# -git package (VCS PKGBUILD, per the AUR guidelines): usv has no tagged
# release yet (docs/ROADMAP.md — pre-v1.0), so this tracks main rather
# than pinning a version that doesn't exist. A plain `unseen-servant`
# package sourced from a release tarball is the natural follow-up once
# v1.0 ships; this file becomes that package's template with the VCS
# bits (source=, pkgver(), _srcname) removed.

pkgname=unseen-servant-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A security-first server for the small networks: Gemini, Titan, Gopher, Spartan, Nex and Finger"
arch=('x86_64')
url="https://forgejo.wanderingmonster.dev/WanderingMonster/unseen-servant"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
provides=('unseen-servant')
conflicts=('unseen-servant')
backup=()
source=("$pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    # Falls back to the bare Cargo.toml version + rev count when there
    # are no tags yet (true today); switches to a real `git describe`
    # once the project's first tag lands, per the standard -git template.
    printf '%s.r%s.g%s' \
        "$(grep -m1 '^version' Cargo.toml | sed -E 's/version = "(.*)"/\1/')" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    # Fetches everything Cargo.lock names, over the network, once — before
    # build()/check() run --frozen (the standard Arch Rust packaging split:
    # prepare() is the only step allowed network access, so its absence
    # from build/check is provable, not just intended). Found live: without
    # this step, `cargo build --frozen` fails outright on a clean machine
    # with "no matching package named `crossterm` found" — --frozen means
    # zero network access, not merely "respect Cargo.lock".
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # makepkg.conf's default flags break ring's build script (it compiles
    # a handful of hand-written C/assembly files via `cc`, then links the
    # result into the Rust binary). Found live, isolating one variable at
    # a time, both real and both independently necessary:
    #  - LDFLAGS carries -Wl,--as-needed, a known breaker for crates that
    #    link hand-assembled static archives with no visible Rust-side
    #    symbol references until the final link.
    #  - CFLAGS/CXXFLAGS carry -flto=auto, which turns ring's plain object
    #    files into LTO bitcode that a non-LTO Rust link can't consume —
    #    the actual cause of the "undefined symbol: ring_core_0_17_14__*"
    #    wall of errors this produced (dozens of symbols, every one of
    #    them a real function ring's build script compiles, just not
    #    reachable through the mismatched LTO representation).
    # A plain `cargo build` outside makepkg's environment reproduces
    # neither failure — this is specifically about what makepkg.conf
    # injects, not usv's own build. Distro hardening flags belong on
    # distro-compiled C/C++; there's no reason to also apply them to the
    # few bytes of C a Rust crate's build.rs compiles internally.
    unset LDFLAGS CFLAGS CXXFLAGS
    cargo build --frozen --release --bin usv
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    unset LDFLAGS CFLAGS CXXFLAGS
    cargo test --frozen --release
}

package() {
    cd "$pkgname"
    install -Dm755 "target/release/usv" "$pkgdir/usr/bin/usv"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "packaging/systemd/usv.service" \
        "$pkgdir/usr/lib/systemd/system/usv.service"
    # Arch's systemd unit convention: /usr/bin, not /usr/local/bin —
    # the reference unit under packaging/systemd/ targets the
    # source-tarball path, so retarget it for this install layout.
    sed -i 's#/usr/local/bin/usv#/usr/bin/usv#' \
        "$pkgdir/usr/lib/systemd/system/usv.service"
    install -Dm644 "packaging/aur/sysusers.conf" \
        "$pkgdir/usr/lib/sysusers.d/usv.conf"
}
